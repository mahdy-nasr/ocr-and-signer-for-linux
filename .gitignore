# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
.Python
.python-version

# --- Virtualenvs ---
.venv/
venv/
env/
ENV/

# --- Packaging / build ---
build/
dist/
wheels/
*.whl
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# --- Debian packaging (when packaging/debian is copied to ./debian for building) ---
debian/.debhelper/
debian/files
debian/*.debhelper
debian/*.debhelper.log
debian/*.substvars
debian/preview-app/
debian/preview-app.postinst.debhelper
debian/preview-app.prerm.debhelper
.pybuild/
*.deb
*.buildinfo
*.changes

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- App runtime / user data ---
# User-generated signatures + OCR cache live in XDG dirs outside the repo,
# but guard against anyone dropping them in-tree by mistake.
signatures/
ocr_cache/

# --- Logs / scratch ---
*.log
scratch/
tmp/

# --- Editors / IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Secrets / env ---
.env
.env.local
.env.*.local
